rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isMember(memberIds) {
      return isSignedIn() && request.auth.uid in memberIds;
    }
    
    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }
    
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }
    
    match /folders/{folderId} {
      allow get: if isSignedIn();
      allow list: if isMember(resource.data.memberIds);
      
      allow create: if isMember(request.resource.data.memberIds) 
                    && isOwner(request.resource.data.ownerId);
                    
      function isSelfJoin() {
        return isSignedIn()
          && request.auth.uid in request.resource.data.memberIds
          && !(request.auth.uid in resource.data.memberIds)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.name == resource.data.name
          && request.resource.data.icon == resource.data.icon
          && request.resource.data.color == resource.data.color
          && request.resource.data.sortKey == resource.data.sortKey
          && request.resource.data.roles[request.auth.uid] == 'editor';
      }

      allow update: if (
                      isMember(resource.data.memberIds)
                      && isMember(request.resource.data.memberIds)
                      // Editor cannot change roles or delete folder
                      // Here we simplify: only owner can change roles/memberIds
                      && (
                        (resource.data.roles[request.auth.uid] == 'owner') 
                        || 
                        (
                          request.resource.data.roles == resource.data.roles &&
                          request.resource.data.memberIds == resource.data.memberIds &&
                          request.resource.data.ownerId == resource.data.ownerId
                        )
                      )
                    )
                    || isSelfJoin();
                    
      allow delete: if isMember(resource.data.memberIds) 
                    && resource.data.roles[request.auth.uid] == 'owner';
    }
    
    match /items/{itemId} {
      function getParent(parentId) {
        return get(/databases/$(database)/documents/items/$(parentId)).data;
      }
      
      allow read: if isMember(resource.data.memberIds) || (
                      isSignedIn() &&
                      resource.data.folderId != null &&
                      request.auth.uid in get(/databases/$(database)/documents/folders/$(resource.data.folderId)).data.memberIds
                    );
      
      allow create: if isMember(request.resource.data.memberIds)
                    // Depth check: if parentId != null, parent exists and parent's parentId == null
                    && (request.resource.data.parentId == null || (
                        exists(/databases/$(database)/documents/items/$(request.resource.data.parentId)) &&
                        getParent(request.resource.data.parentId).parentId == null
                    ))
                    // Reminder invariant: if shared, reminder == null
                    && (request.resource.data.memberIds.size() <= 1 || !("reminder" in request.resource.data) || request.resource.data.reminder == null)
                    // Subtasks inherit folderId/memberIds/ownerId
                    && (request.resource.data.parentId == null || (
                        request.resource.data.folderId == getParent(request.resource.data.parentId).folderId &&
                        request.resource.data.memberIds == getParent(request.resource.data.parentId).memberIds &&
                        request.resource.data.ownerId == getParent(request.resource.data.parentId).ownerId
                    ));
                    
      allow update: if (
                      isMember(resource.data.memberIds)
                      || (
                        isSignedIn()
                        && resource.data.folderId != null
                        && request.auth.uid in get(/databases/$(database)/documents/folders/$(resource.data.folderId)).data.memberIds
                        && request.auth.uid in request.resource.data.memberIds
                        && request.resource.data.folderId == resource.data.folderId
                        && request.resource.data.parentId == resource.data.parentId
                        && request.resource.data.ownerId == resource.data.ownerId
                        && request.resource.data.title == resource.data.title
                        && request.resource.data.done == resource.data.done
                        && request.resource.data.sortKey == resource.data.sortKey
                      )
                    )
                    && isMember(request.resource.data.memberIds)
                    // Depth check for move
                    && (request.resource.data.parentId == null || (
                        exists(/databases/$(database)/documents/items/$(request.resource.data.parentId)) &&
                        getParent(request.resource.data.parentId).parentId == null
                    ))
                    // Reminder invariant
                    && (request.resource.data.memberIds.size() <= 1 || !("reminder" in request.resource.data) || request.resource.data.reminder == null);
                    
      allow delete: if isMember(resource.data.memberIds);
    }
  }
}
